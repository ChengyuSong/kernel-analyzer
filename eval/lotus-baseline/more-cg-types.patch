   case CGType::AserPTA_2CFA:
     buildCGWithAserPTAImpl<KCallSite<2>>(M, CG);
     break;
+  case CGType::AserPTA_Origin:
+    // [kanalyzer eval patch] origin-sensitive AserPTA with the origin rule
+    // of tools/alias/lotus-alias-aser-aa.cpp (thread-spawn call sites
+    // start a new origin; everything else stays in its origin).
+    KOrigin<1>::setOriginRules(
+        [](const KOrigin<1> *, const llvm::Instruction *I) -> bool {
+          if (auto *CB = llvm::dyn_cast<llvm::CallBase>(I)) {
+            if (auto *F = CB->getCalledFunction()) {
+              llvm::StringRef Name = F->getName();
+              return Name.equals("pthread_create") || Name.contains("spawn") ||
+                     Name.contains("thread");
+            }
+          }
+          return false;
+        });
+    buildCGWithAserPTAImpl<KOrigin<1>>(M, CG);
+    break;
   default:
     llvm::WithColor::error() << "Invalid AserPTA variant\n";
     break;
