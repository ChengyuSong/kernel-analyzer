+static void printIcallSitesJson(llvm::CallGraph &CG, llvm::StringRef Path) {
+  llvm::Module &M = CG.getModule();
+  std::map<std::string, std::set<std::string>> ByLoc;
+  size_t Sites = 0, NoDbg = 0, Unresolved = 0;
+  for (llvm::Function &F : M) {
+    if (F.isDeclaration())
+      continue;
+    llvm::CallGraphNode *Node = CG[&F];
+    for (llvm::BasicBlock &BB : F) {
+      for (llvm::Instruction &I : BB) {
+        auto *CB = llvm::dyn_cast<llvm::CallBase>(&I);
+        if (!CB || CB->isInlineAsm())
+          continue;
+        if (llvm::isa<llvm::Function>(
+                CB->getCalledOperand()->stripPointerCastsAndAliases()))
+          continue;
+        Sites++;
+        const llvm::DebugLoc &DL = CB->getDebugLoc();
+        if (!DL) {
+          NoDbg++;
+          continue;
+        }
+        std::string Key = (DL->getScope()->getFilename() + ":" +
+                           llvm::Twine(DL->getLine()))
+                              .str();
+        std::set<std::string> &Targets = ByLoc[Key];
+        size_t Before = Targets.size();
+        bool Any = false;
+        if (Node)
+          for (auto &Record : *Node) {
+            if (!Record.first.hasValue() ||
+                Record.first.getValue() != static_cast<llvm::Value *>(CB))
+              continue;
+            if (Record.second && Record.second->getFunction()) {
+              Targets.insert(Record.second->getFunction()->getName().str());
+              Any = true;
+            }
+          }
+        (void)Before;
+        if (!Any)
+          Unresolved++;
+      }
+    }
+  }
+  std::error_code EC;
+  llvm::raw_fd_ostream OS(Path, EC, llvm::sys::fs::OF_Text);
+  if (EC) {
+    llvm::errs() << "FATAL: cannot write " << Path << ": " << EC.message()
+                 << "\n";
+    std::exit(2);
+  }
+  OS << "{";
+  bool FirstK = true;
+  for (const auto &KV : ByLoc) {
+    OS << (FirstK ? "" : ",") << "\n  \"";
+    FirstK = false;
+    OS.write_escaped(KV.first);
+    OS << "\": [";
+    bool FirstT = true;
+    for (const std::string &T : KV.second) {
+      OS << (FirstT ? "" : ", ") << "\"";
+      FirstT = false;
+      OS.write_escaped(T);
+      OS << "\"";
+    }
+    OS << "]";
+  }
+  OS << "\n}\n";
+  llvm::errs() << "icall-sites: sites=" << Sites << " keys=" << ByLoc.size()
+               << " no-dbg=" << NoDbg << " unresolved=" << Unresolved
+               << "\n";
+}
