@@ -31,6 +31,13 @@
   const GPG *summary(const llvm::Function *function) const;
   const GPG *initialGPG(const llvm::Function *function) const;
   const ProgramModel &programModel() const { return model_; }
+  // [kanalyzer eval patch] indirect calls whose target set was still empty
+  // after the points-to fixpoint, so addFallbackIndirectTargets() filled
+  // them with every address-taken, signature-compatible function. Their
+  // targets in result() come from that fallback, not from points-to.
+  const std::set<const llvm::CallBase *> &fallbackIndirectCalls() const {
+    return fallback_calls_;
+  }
 
 private:
   using TargetSet = std::set<const llvm::Function *>;
@@ -46,6 +53,7 @@
   std::map<const llvm::Function *, GPG> initial_graphs_;
   std::map<const llvm::Function *, GPG> summaries_;
   TargetMap indirect_targets_;
+  std::set<const llvm::CallBase *> fallback_calls_; // [kanalyzer eval patch]
   GPUSet observed_gpus_;
   GPGResult result_;
   AnalysisStats stats_;
